@startuml
!include utils/C4_Context.puml
!include utils/C4_Container.puml
!include utils/C4_Component.puml

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!define DEVICONS2 https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons2
!define FONTAWESOME https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/font-awesome-5
!define MATERIAL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/material

!include DEVICONS/python.puml
!include DEVICONS2/mongodb_wordmark.puml
!include DEVICONS2/redis_wordmark.puml
!include MATERIAL/router.puml
!include FONTAWESOME/users.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

Person(api_client, "API Client", "Внешний клиент, вызывающий публичный API", $sprite="users")

Container(api_gateway, "api-gateway", "Apache APISIX Gateway", "Единая точка входа (Apache APISIX), аутентификация, rate limiting, маршрутизация на внутренние сервисы", $sprite="router")

Container(cdn, "cdn", "CDN (Content Delivery Network)", "Глобальный CDN для раздачи статического контента, кеширование статики и ответов backend", $sprite="router")

System_Boundary(app_services, "Application Services") {
    Container(pymongo_api_1, "pymongo_api-1", "pymongo_api (Python, FastAPI + PyMongo)", "Инстанс backend-сервиса работы с MongoDB (FastAPI + PyMongo, instance 1)", $sprite="python")
    Container(pymongo_api_2, "pymongo_api-2", "pymongo_api (Python, FastAPI + PyMongo)", "Инстанс backend-сервиса работы с MongoDB (FastAPI + PyMongo, instance 2)", $sprite="python")

    Container(mongos_router, "mongos_router", "mongos (MongoDB router)", "Маршрутизатор запросов к шардированному кластеру MongoDB", $sprite="router")
}

System_Boundary(service_discovery, "Service Discovery") {
    ContainerDb(consul_server, "consul", "HashiCorp Consul", "Регистр сервисов, health-checks и service discovery для api-gateway и pymongo_api")
}

System_Boundary(mongo_cluster, "MongoDB Sharded Cluster") {
    ContainerDb(configSrv, "configSrv", "MongoDB configSrv", "Сервис конфигурационного сервера (primary)", $sprite="mongodb_wordmark")
    ContainerDb(configSrvReplica1, "configSrvReplica1", "MongoDB configSrv", "Сервис конфигурационного сервера (replica 1)", $sprite="mongodb_wordmark")
    ContainerDb(configSrvReplica2, "configSrvReplica2", "MongoDB configSrv", "Сервис конфигурационного сервера (replica 2)", $sprite="mongodb_wordmark")

    ContainerDb(shard1, "shard1", "MongoDB shard", "Сервис шарда 1 (primary)", $sprite="mongodb_wordmark")
    ContainerDb(shard1Replica, "shard1Replica", "MongoDB shard", "Сервис шарда 1 (replica)", $sprite="mongodb_wordmark")
    ContainerDb(shard2, "shard2", "MongoDB shard", "Сервис шарда 2 (primary)", $sprite="mongodb_wordmark")
    ContainerDb(shard2Replica, "shard2Replica", "MongoDB shard", "Сервис шарда 2 (replica)", $sprite="mongodb_wordmark")
}

System_Boundary(redis_cluster, "Redis Cluster") {
    ContainerDb(redis_1, "redis_1", "Redis", "Узел Redis 1 (master)", $sprite="redis_wordmark")
    ContainerDb(redis_2, "redis_2", "Redis", "Узел Redis 2 (master)", $sprite="redis_wordmark")
    ContainerDb(redis_3, "redis_3", "Redis", "Узел Redis 3 (master)", $sprite="redis_wordmark")
    ContainerDb(redis_4, "redis_4", "Redis", "Узел Redis 4 (replica)", $sprite="redis_wordmark")
    ContainerDb(redis_5, "redis_5", "Redis", "Узел Redis 5 (replica)", $sprite="redis_wordmark")
    ContainerDb(redis_6, "redis_6", "Redis", "Узел Redis 6 (replica)", $sprite="redis_wordmark")
}

Rel_Down(api_client, api_gateway, "HTTPS/JSON (динамический API)")
Rel_Down(api_client, cdn, "HTTPS (статический контент)")

Rel_Down(api_gateway, pymongo_api_1, "HTTP/JSON (через Consul, instance 1)")
Rel_Down(api_gateway, pymongo_api_2, "HTTP/JSON (через Consul, instance 2)")

Rel_Right(cdn, api_gateway, "Забирает статический контент (origin для CDN)")

Rel_Right(api_gateway, consul_server, "Запрос сервисов и их состояний (service discovery)")

Rel_Right(pymongo_api_1, consul_server, "Регистрация сервиса, health-checks, получение конфигурации")
Rel_Right(pymongo_api_2, consul_server, "Регистрация сервиса, health-checks, получение конфигурации")

Rel_Down(pymongo_api_1, mongos_router, "PyMongo")
Rel_Down(pymongo_api_2, mongos_router, "PyMongo")

Rel_Right(pymongo_api_1, redis_1, "Кэширование данных")
Rel_Right(pymongo_api_1, redis_2, "Кэширование данных")
Rel_Right(pymongo_api_1, redis_3, "Кэширование данных")
Rel_Right(pymongo_api_2, redis_1, "Кэширование данных")
Rel_Right(pymongo_api_2, redis_2, "Кэширование данных")
Rel_Right(pymongo_api_2, redis_3, "Кэширование данных")

Rel_Right(mongos_router, configSrv, "Пишет/читает метаданные шардинга (primary)")
Rel_Right(mongos_router, configSrvReplica1, "Читает метаданные шардинга (replica 1)")
Rel_Right(mongos_router, configSrvReplica2, "Читает метаданные шардинга (replica 2)")

Rel_Down(mongos_router, shard1, "Read/Write")
Rel_Down(mongos_router, shard2, "Read/Write")
Rel_Down(mongos_router, shard1Replica, "Read")
Rel_Down(mongos_router, shard2Replica, "Read")

Rel_Right(shard1, shard1Replica, "Replication")
Rel_Right(shard2, shard2Replica, "Replication")
Rel_Right(configSrv, configSrvReplica1, "Репликация метаданных конфигурации")
Rel_Right(configSrvReplica1, configSrvReplica2, "Репликация метаданных конфигурации")

Rel_Right(redis_1, redis_4, "Replication / Cluster")
Rel_Right(redis_2, redis_5, "Replication / Cluster")
Rel_Right(redis_3, redis_6, "Replication / Cluster")

@enduml


